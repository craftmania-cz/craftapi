{
  "name": "craftapi-2",
  "version": "1.10.0",
  "description": "CraftMania.CZ REST API in TypeScript and NodeJS.",
  "main": "index.js",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist/*",
    "start": "node dist/server.js",
    "watch": "nodemon dist/server.js",
    "test": "mocha --reporter spec --require ts-node/register 'test/**/*.test.ts'",
    "lint": "eslint src --ext .ts",
    "develop": "npm run clean && npm run build && npm run watch",
    "changelog": "auto-changelog --template keepachangelog --commit-limit false"
  },
  "keywords": [
    "node",
    "typescript",
    "api",
    "craftmania"
  ],
  "author": "MrWakeCZ",
  "license": "Apache 2.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/chai-http": "3.0.5",
    "@types/config": "3.3.5",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.12",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "25.3.5",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "chai": "4.5.0",
    "chai-http": "4.4.0",
    "eslint": "9.27.0",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@sentry/node": "9.16.1",
    "accesscontrol": "2.2.1",
    "axios": "1.13.6",
    "bcryptjs": "3.0.3",
    "config": "4.4.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "express": "5.2.1",
    "express-handlebars": "8.0.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.1.0",
    "mc-ping-updated": "0.1.1",
    "morgan": "1.10.1",
    "mysql2": "3.19.0",
    "winston": "3.19.0"
  }
